#!/usr/bin/env python3
"""Inject the project deployment credential without persisting it."""

import json
import os
import subprocess
import sys
from urllib.error import HTTPError
from urllib.request import Request, urlopen

ADDRESS = os.environ.get("PERSONAL_OPENBAO_ADDR", "https://secrets.j4k4.dev").rstrip("/")
PROJECT = "jakob-kruse-de"
PATH = PROJECT + "/data/prod/deployment"


def request(path, token=None, body=None):
    headers = {"Content-Type": "application/json"}
    if token:
        headers["X-Vault-Token"] = token
    data = json.dumps(body).encode() if body is not None else None
    try:
        with urlopen(Request(ADDRESS + "/v1/" + path, data, headers), timeout=30) as response:
            payload = response.read()
            return response.status, json.loads(payload) if payload else {}
    except HTTPError as error:
        return error.code, {}


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def main():
    args = sys.argv[1:]
    require(len(args) >= 2 and args[0] == "--production",
            "Usage: scripts/with-openbao --production <command> [args...] | --check")
    args = args[1:]
    check = args == ["--check"]
    jwt = subprocess.run(
        ["amp", "orb", "id-token", "--audience", "urn:openbao:amp:" + PROJECT + ":prod-operator",
         "--subject-scope", "project", "--ttl-seconds", "60"],
        check=True, capture_output=True, text=True, timeout=60,
    ).stdout.strip()
    status, result = request("auth/amp/login", body={"role": PROJECT + "-prod-operator", "jwt": jwt})
    require(status == 200, "OpenBao workload login failed.")
    token = result["auth"]["client_token"]
    try:
        require(result["auth"]["policies"] == [PROJECT + "-prod-operator-read"]
                and 0 < result["auth"]["lease_duration"] <= 300, "Unexpected session permissions.")
        status, result = request(PATH, token)
        require(status == 200, "Project deployment credential unavailable.")
        values = result["data"]["data"]
        require(set(values) == {"CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"}
                and all(isinstance(v, str) and v for v in values.values()), "Invalid deployment settings.")
        if check:
            require(request(PATH, token, {})[0] == 403, "Write isolation failed.")
            require(request("personal/data/cloudflare", token)[0] == 403, "Admin isolation failed.")
            require(request(PROJECT + "/data/dev/deployment", token)[0] == 403, "Environment isolation failed.")
    finally:
        require(request("auth/token/revoke-self", token, {})[0] == 204, "Session revocation failed.")
    if check:
        require(request(PATH, token)[0] == 403, "Revoked session is still usable.")
        print("OK: production credential readable; writes and unrelated reads denied; session revoked.")
        return
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("PERSONAL_", "VAULT_", "BAO_", "OPENBAO_", "INFISICAL_", "CLOUDFLARE_"))}
    env.update(values)
    os.execvpe(args[0], args, env)


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
        print("Secret loading failed; sensitive details withheld.", file=sys.stderr)
        sys.exit(1)
